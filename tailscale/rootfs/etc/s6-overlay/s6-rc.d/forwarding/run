#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Tailscale
# Forward incoming tailnet connections to the host's primary interface
# ==============================================================================

readonly NM_DISPATCHER_MONITOR_FIFODIR=/run/nm-dispatcher-monitor-fifodir
readonly LISTENER_QUEUE="${NM_DISPATCHER_MONITOR_FIFODIR}/forwarding"

declare action
declare readiness_reported=false
declare local_addresses_to_remove
declare local_addresses_to_setup

mkfifo "${LISTENER_QUEUE}"

# Pin it to prevent closing it by other processes
exec 4<>"${LISTENER_QUEUE}"

# Startup/readiness trigger
echo 'init' > "${LISTENER_QUEUE}"

setup-forwarding-to-host

while IFS= read -r -u 4 action
do
  # Due to race with nm-dispatcher-monitor, it's possible that the init event is not the first in the queue
  if bashio::var.false "${readiness_reported}"; then
    echo "" >&3
    exec 3>&-
    readiness_reported=true
  fi
  case "${action}" in
    up|down)
      bashio::log.info "Handling Network Manager action ${action} in forwarding service"
      remove-forwarding-to-host
      setup-forwarding-to-host
      ;;
    dhcp4-change|dhcp6-change|reapply)
      # Do anything only when the addresses are really changed
      local_addresses_to_remove="$(remove-forwarding-to-host test)"
      local_addresses_to_setup="$(setup-forwarding-to-host test)"
      if ! bashio::var.equals "${local_addresses_to_remove}" "${local_addresses_to_setup}"; then
        bashio::log.info "Handling Network Manager action ${action} in forwarding service"
        remove-forwarding-to-host
        setup-forwarding-to-host
      fi
      ;;
  esac
done
