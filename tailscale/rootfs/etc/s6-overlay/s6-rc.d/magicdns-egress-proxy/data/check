#!/usr/bin/env bash
# shellcheck shell=bash

set -o errexit
set -o errtrace
set -o nounset
set -o pipefail
shopt -s inherit_errexit

readonly DNSMASQ_EGRESS_ADDRESS_IPV4="127.100.100.100"

declare result

result=$(dig "@${DNSMASQ_EGRESS_ADDRESS_IPV4}" readiness.egress.tailscale.app A +short 2>/dev/null) && [[ -n "${result}" ]]
