#!/usr/bin/env bash
# shellcheck shell=bash

set -o errexit
set -o errtrace
set -o nounset
set -o pipefail
shopt -s inherit_errexit

readonly MAGIC_DNS_IPV4="100.100.100.100"
readonly MAGIC_DNS_IPV6="fd7a:115c:a1e0::53"

readonly DNSMASQ_INGRESS_PORT_LOCATION="/run/dnsmasq_ingress_port"

declare tailscale_address_ipv4
declare tailscale_address_ipv6

declare result

tailscale_address_ipv4=$(/opt/tailscale ip -4 2>/dev/null || true)
tailscale_address_ipv6=$(/opt/tailscale ip -6 2>/dev/null || true)

if [[ -s "${DNSMASQ_INGRESS_PORT_LOCATION}" ]]; then
  # in case forwarding is only set up by the magicdns-proxies-reconfigurator service, check dnsmasq process existence only
  pgrep -f "^dnsmasq.*?--listen-address=${tailscale_address_ipv6}.*?--port=$(<"${DNSMASQ_INGRESS_PORT_LOCATION}")" &>/dev/null
else
  # The shellcheck is false alarm
  # shellcheck disable=SC1083
  { [[ -z "${tailscale_address_ipv4}" ]] || \
    { result=$(dig "@${MAGIC_DNS_IPV4}" readiness.ingress.tailscale.app A +short 2>/dev/null) && [[ -n "${result}" ]] } } && \
  { [[ -z "${tailscale_address_ipv6}" ]] || \
    { result=$(dig "@${MAGIC_DNS_IPV6}"  readiness.ingress.tailscale.app AAAA +short 2>/dev/null) && [[ -n "${result}" ]] } }
fi
