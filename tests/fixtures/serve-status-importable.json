{
  "Services": {
    "svc:db": {
      "TCP": {
        "5432": {
          "TCPForward": "192.168.1.20:5432"
        }
      }
    },
    "svc:dns": {
      "TCP": {
        "80": {
          "HTTP": true
        }
      },
      "Web": {
        "dns.example.ts.net:80": {
          "Handlers": {
            "/": {
              "Proxy": "http://nas.local:8080"
            }
          }
        }
      }
    },
    "svc:tls": {
      "TCP": {
        "8443": {
          "TCPForward": "[fd00::10]:443",
          "TerminateTLS": "tls.example.ts.net"
        }
      }
    },
    "svc:web": {
      "TCP": {
        "443": {
          "HTTPS": true
        },
        "80": {
          "HTTP": true
        }
      },
      "Web": {
        "web.example.ts.net:443": {
          "Handlers": {
            "/": {
              "Proxy": "http://localhost:8123"
            },
            "/api": {
              "Proxy": "https+insecure://192.168.1.50:8443"
            }
          }
        },
        "web.example.ts.net:80": {
          "Handlers": {
            "/": {
              "Proxy": "http://127.0.0.1:8123"
            }
          }
        }
      }
    }
  }
}
